PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/doc_marketplace?schema=public"
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/doc_marketplace?schema=public"

# Generate a unique value with at least 32 characters. Never commit the real value.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Supabase Storage
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET="studydocs"

# Document conversion
GOTENBERG_URL="http://localhost:3000"

# Required in production for password reset emails
MAIL_USER="your-smtp-user@example.com"
MAIL_PASS="your-smtp-app-password"

# Set true only when API documentation should be exposed in production.
ENABLE_SWAGGER="false"

# Firebase Auth (Phone OTP Verification)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# Local development only. The backend refuses this mode in production.
ENABLE_MOCK_OTP="false"

# Required explicitly only when running `npm run seed` outside production.
ALLOW_SEED="false"

# OAuth config
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"

# VNPay Sandbox
VNPAY_TMN_CODE="your-tmn-code"
VNPAY_HASH_SECRET="your-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
