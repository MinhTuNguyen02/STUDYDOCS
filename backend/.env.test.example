# E2E tests never fall back to backend/.env. Export these values in the shell/CI.
TEST_DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/studydocs_test?schema=public"
TEST_DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/studydocs_test?schema=public"

# Use a dedicated test Supabase project/bucket or a compatible local test service.
TEST_SUPABASE_URL="https://test-project-ref.supabase.co"
TEST_SUPABASE_SERVICE_ROLE_KEY="test-service-role-key"
TEST_SUPABASE_STORAGE_BUCKET="studydocs-test"

# Must be explicitly true when TEST_DATABASE_URL is remote.
ALLOW_REMOTE_TEST_DATABASE="false"
